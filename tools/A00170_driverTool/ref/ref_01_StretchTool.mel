                                        -command ("JUN_cmd_delete_selected(\""+$name_tsl_stretchObjs+"\")");
                                button -label "Up" // 1
                                        -width ($win_width/8 - 12)
                                        -command ("JUN_cmd_selMov(\""+$name_tsl_stretchObjs+"\"," + 1 + ")");
                                button -label "down" // 0
                                        -width ($win_width/8 - 12)
                                        -command ("JUN_cmd_selMov(\""+$name_tsl_stretchObjs+"\"," + 0 + ")");
                            setParent ..;

                            string $name_btn_distObjs = `button -label "Select Stretch Objects" 
                                                                -align "center"`;

                        // columnLayout : Stretch Objects (close)
                        setParent ..;

                        // columnLayout : Stretch Object's Attributs(open)
                        columnLayout -adjustableColumn true -columnAttach "both" 5 -rowSpacing 5;
                            text -align "left" -label "Attributes";
                            string $name_tsl_attr_stretchObjs = `textScrollList -h $tsl_hight_tab2 -numberOfRows 5 -allowMultiSelection true`;
                            string $name_tf_searchStrcAttr = `textField -alwaysInvokeEnterCommandOnReturn 1`;
                            string $name_btn_serch_distAttr = `button -label "Search" -align "center"`;
                        // columLayout : Stretch Object's Attributs (close)
                        setParent ..;
                    // paneLayout vertical2 (close)
                    setParent ..;

                //edit 
                textField -e -enterCommand ("JUN_cmd_upd_tsl_search(\""+$name_tsl_attr_stretchObjs+"\",\""+$name_tf_searchStrcAttr+"\",\""+$name_tsl_stretchObjs+"\")") $name_tf_searchStrcAttr;
                button -e -command ("JUN_cmd_upd_tsl_obj_n_attr(\""+$name_tsl_stretchObjs+"\", \""+ $name_tsl_attr_stretchObjs + "\",\"" + $name_tex_numDist + "\")") $name_btn_distObjs;
                button -e -command ("JUN_cmd_upd_tsl_search(\""+$name_tsl_attr_stretchObjs+"\",\""+$name_tf_searchStrcAttr+"\",\""+$name_tsl_stretchObjs+"\")") $name_btn_serch_distAttr;

                //-------------------------------------------------
                // frameLayout B :  Distination Objects(close)
                //-------------------------------------------------
                setParent ..;

                columnLayout -adjustableColumn true  -columnAttach "both" 5 -rowSpacing 10;
                   button -label "Apply Stretch" 
                                -width ($win_width - 10)
                                -command ("JUN_cmd_makeStretch(\""+$name_tsl_defaultDist+"\",\""+$name_tsl_attr_defaultDist+"\",\""+$name_tsl_stretchObjs+"\",\""+$name_tsl_attr_stretchObjs+"\")");
                setParent..;

            //-------------------------------------------------
            // columnLayout : tab 2 (close)
            //-------------------------------------------------
            setParent ..;
        
        //-------------------------------------------------
        // tabLayout_All (close)
        //-------------------------------------------------
         setParent ..;

    tabLayout -e
              -tabLabel $tabLayout_Curve "Distance"
              -tabLabel $tabLayout_Divide "Stretch"
              $tabLayout_All;
              
    text -align "right" -label "Copyright (c) Ji Hun Park. All rights reserved.";

    //-------------------------------------------------
    // columeLayout : Whole_form (close)
    //-------------------------------------------------
    setParent ..;
    showWindow $winName;
    window -e -wh $win_width $win_hight $winName;
}

JUN_makeUI_MEL_Stretch_Tool();
