                button -e -command ("JUN_cmd_upd_tsl_obj_n_attr(\""+$name_tsl_defaultDist+"\", \""+ $name_tsl_attr_defaultDist + "\",\"" + $name_tex_numSrc + "\")") $name_btn_selSrcObjs;
                button -e -command ("JUN_cmd_upd_tsl_search(\""+$name_tsl_attr_defaultDist+"\",\""+$name_tf_searchDefDistAttr+"\",\""+$name_tsl_defaultDist+"\")") $name_btm_serch_fromTfg;
                    
