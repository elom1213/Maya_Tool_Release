                            string $name_tf_searchDefDistAttr = `textField -alwaysInvokeEnterCommandOnReturn 1`;
                            string $name_btm_serch_fromTfg = `button -label "Search" -align "center"`;
                        // columLayout : Distance Object's Attributs (close)
