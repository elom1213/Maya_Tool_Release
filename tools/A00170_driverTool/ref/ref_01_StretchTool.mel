                            string $name_tsl_stretchObjs = `textScrollList -h $tsl_hight_tab2 -numberOfRows 5 -allowMultiSelection true`;
                            textScrollList -e -selectCommand ("JUN_cmd_tsl_select(\"" + $name_tsl_stretchObjs +"\")") $name_tsl_stretchObjs;

