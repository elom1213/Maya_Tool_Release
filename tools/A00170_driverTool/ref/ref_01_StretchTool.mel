//===================================================================================
// UI Commands : Text Scroll List Button
// Up, Down Selections
//===================================================================================

global proc string[] JUN_appendString(string $array[], string $item)
{
    int $position_insert = size($array);
    stringArrayInsertAtIndex($position_insert, $array, $item);
    return $array;
}

global proc int[] JUN_get_reversedArray_int(int $input_array[])
{
    int $result_array[];
    for($i = 0; $i < size($input_array); $i++)
        $result_array[size($input_array) - $i - 1] = $input_array[$i];
    return $result_array;
}

global proc string[] JUN_get_reversedArray_str(string $input_array[])
{
    string $result_array[];
    for($i = 0; $i < size($input_array); $i++)
        $result_array[size($input_array) - $i - 1] = $input_array[$i];
    return $result_array;
}

global proc int JUN_get_index_insert(int $JUN_flag_isUp,
                                       int $JUN_index_selected,
                                       int $JUN_size_allItems) 
{
    int $JUN_index_insert;
    // {"a", "b" , "c" } "a"'s JUN_index_selected = 1
    if($JUN_flag_isUp)
    {
        if($JUN_index_selected == 1)
            $JUN_index_insert = $JUN_size_allItems;
        else
            $JUN_index_insert = $JUN_index_selected - 2;
    }
    else
    {
        if($JUN_index_selected == $JUN_size_allItems)
            $JUN_index_insert = 0;
        else
            $JUN_index_insert = $JUN_index_selected;
    }
    return $JUN_index_insert;
}

global proc JUN_cmd_selMov(string $JUN_name_tsl, int $JUN_flag_isUp)
{
    string $JUN_objs_allItems[] = `textScrollList -q -allItems $JUN_name_tsl`;
    string $JUN_objs_selected[] = `textScrollList -q -selectItem  $JUN_name_tsl`;
    int $JUN_indexs_selected[] = `textScrollList -q -selectIndexedItem $JUN_name_tsl`;
    int $JUN_count = 0;
    int $JUN_flag_isCrossed = 0;

    if(!$JUN_flag_isUp)
    {
         $JUN_indexs_selected = JUN_get_reversedArray_int($JUN_indexs_selected);
         $JUN_objs_selected = JUN_get_reversedArray_str($JUN_objs_selected);
    }

    for($JUN_index_selected in $JUN_indexs_selected)
    {
        int $JUN_index_insert =  JUN_get_index_insert($JUN_flag_isUp,
                                                  $JUN_index_selected,
                                                  size($JUN_objs_allItems));

        // remove i's item from JUN_objs_allItems

        string $JUN_obj_delete[];
        JUN_appendString($JUN_obj_delete, $JUN_objs_selected[$JUN_count]);
        $JUN_objs_allItems = stringArrayRemove($JUN_obj_delete, $JUN_objs_allItems);

        // insert at JUN_index_insert's position
        // if JUN_index_insert = 1 -> isert between a, b in {"a", "b", "c"}

        stringArrayInsertAtIndex($JUN_index_insert, $JUN_objs_allItems, $JUN_objs_selected[$JUN_count++]);
    }

    textScrollList -e -removeAll $JUN_name_tsl;
    for($JUN_obj_allItem in $JUN_objs_allItems)
        textScrollList -e -append $JUN_obj_allItem $JUN_name_tsl;
    
    for($JUN_obj_selected in $JUN_objs_selected)
        textScrollList -e -selectItem $JUN_obj_selected $JUN_name_tsl;

}

//===================================================================================
// UI Commands : Text Scroll List Button
// Add, Delete Selections
//===================================================================================

global proc JUN_cmd_tsl_select(string $name_tsl_selected)
{
    string $JUN_objs_selected[] = `textScrollList -q -selectItem $name_tsl_selected`;
    select $JUN_objs_selected;
}

global proc JUN_cmd_upd_tsl_append_list(string $name_tsl, string $list_append[])
{
    string $i;
    for($i in $list_append)
      textScrollList -e -append $i $name_tsl;
}

global proc JUN_cmd_append_list(string $name_tsl, string $list_append[])
{
    string $i;
    for($i in $list_append)
      textScrollList -e -append $i $name_tsl;
}

global proc JUN_cmd_append_selected(string $name_tsl_objs)
{
    string $sl[] = `ls -sl`;
    JUN_cmd_append_list($name_tsl_objs, $sl);
    select -clear;
}

global proc JUN_cmd_delete_selected(string $name_tsl_objs)
{
    string $items[] = `textScrollList -q -selectItem $name_tsl_objs`;
    string $i;
    for($i in $items)
        textScrollList -e -removeItem $i $name_tsl_objs;
}

global proc JUN_cmd_Clear_And_Select(string $name_tsl_objs)
{
    textScrollList -e -removeAll $name_tsl_objs;
    JUN_cmd_append_selected($name_tsl_objs);
}


global proc JUN_cmd_upd_tex_numTsl(string $name_tsl_objs, string $name_tex_numSelect)
{
    textScrollList -e -removeAll $name_tsl_objs;
    JUN_cmd_append_selected($name_tsl_objs);
    int $JUN_num_selected = `textScrollList -q -numberOfItems $name_tsl_objs`;
    text -e -label ("Number : " + $JUN_num_selected) $name_tex_numSelect;
}




//===================================================================================
// lower
//===================================================================================


global proc JUN_stretch_aimCrv(string $strcObj, 
                               string $strcAttr, 
                               float $defaultDist)
{
     string $nod_animCrv = `connectionInfo -sourceFromDestination ($strcObj+"."+$strcAttr)`;
    string $buffer[];
    tokenize $nod_animCrv "." $buffer;
    $nod_animCrv = $buffer[0];
    setKeyframe -f (2*$defaultDist) -v 2 $nod_animCrv;
    setAttr ($nod_animCrv + ".postInfinity") 4; // Cycle with offset
}


//===================================================================================
// is
//===================================================================================

global proc int JUN_is_exist(string $base_str, string $input_token)
{
    string $result = `match $input_token $base_str`;
    if($result == $input_token)
        return 1;
    return 0;
}


//===================================================================================
// UI Commands : Main
//===================================================================================

//-------------------------------------------------
// Tab 1
// Commands : Distance
//-------------------------------------------------

global proc JUN_cmd_selStrEnd(string $name_tsl_start, string $name_tsl_end)
{
    string $objs_selected[] = `ls -sl`;
    string $list_start[];
    string $list_end[];

    for($i=0; $i<size($objs_selected)-1;$i++)
    {
        JUN_appendString($list_start, $objs_selected[$i]);
        JUN_appendString($list_end, $objs_selected[$i+1]);
    }

    textScrollList -e -removeAll $name_tsl_start;
    textScrollList -e -removeAll $name_tsl_end;

    JUN_cmd_append_list($name_tsl_start, $list_start);
    JUN_cmd_append_list($name_tsl_end, $list_end);
}

global proc JUN_cmd_addStrEnd(string $name_tsl_start, string $name_tsl_end)
{
    string $objs_selected[] = `ls -sl`;
    if(size($objs_selected) != 2)
        error("Must select 2 objects to Add\n");
    
    JUN_cmd_append_list($name_tsl_start, {$objs_selected[0]});
    JUN_cmd_append_list($name_tsl_end, {$objs_selected[1]});
}

global proc JUN_cmd_makeDist(string $name_tsl_start, string $name_tsl_end)
{
    string $objs_str[] = `textScrollList -q -allItems $name_tsl_start`;
    string $objs_end[] = `textScrollList -q -allItems $name_tsl_end`;
    int $objs_siz = size($objs_str) > size($objs_end) ? size($objs_end) : size($objs_str);

    if(size($objs_str) == 1)
        for($i=0;$i<size($objs_end);$i++)
        {
            float $vct_sp[] = `xform -q -worldSpace -translation $objs_str[0]`;
            float $vct_ep[] = `xform -q -worldSpace -translation $objs_end[$i]`;
            string $dist = `distanceDimension -sp $vct_sp[0] $vct_sp[1] $vct_sp[2] -ep $vct_ep[0] $vct_ep[1] $vct_ep[2]`;
        }
    else
        for($i=0;$i<$objs_siz;$i++)
        {
            float $vct_sp[] = `xform -q -worldSpace -translation $objs_str[$i]`;
            float $vct_ep[] = `xform -q -worldSpace -translation $objs_end[$i]`;
            string $dist = `distanceDimension -sp $vct_sp[0] $vct_sp[1] $vct_sp[2] -ep $vct_ep[0] $vct_ep[1] $vct_ep[2]`;
        }
}


//-------------------------------------------------
// Tab 2
// Commands : Stretch
//-------------------------------------------------

global proc JUN_cmd_upd_tsl_attr(string $JUN_name_tsl_objSrc, 
                                 string $JUN_name_tsl_attr,
                                 string $JUN_attr_searchInput)
{
    string $JUN_objs_src[] = `textScrollList -q -allItems $JUN_name_tsl_objSrc`;
    string $JUN_list_attr_old[] = `listAttr $JUN_objs_src[0]`;
    string $JUN_list_attr_new[];

    if($JUN_attr_searchInput != "")
        $JUN_list_attr_old = `listAttr ($JUN_objs_src[0]+"."+$JUN_attr_searchInput)`;
    
    for($i=0;$i<size($JUN_list_attr_old);$i++)
    {
        // if exist "." in $JUN_list_attr_old[$i] -> ignore
        if(JUN_is_exist($JUN_list_attr_old[$i], "\\.")) continue;

        // get "obj.attr"
        string $fullName_compund = $JUN_objs_src[0] + "." + $JUN_list_attr_old[$i];
        int $indx_freeToConnect;
        if(catchQuiet($indx_freeToConnect = getNextFreeMultiIndex($fullName_compund, 0)))
        {
            // if is not compound attribute
            // push $JUN_list_attr_old[$i] to $JUN_list_attr_new

            stringArrayInsertAtIndex(size($JUN_list_attr_new), $JUN_list_attr_new, $JUN_list_attr_old[$i]);
        }
        else
        {
            // if exist object.attr[?]
            // push
            // object.attr[?].A
            // object.attr[?].B
            // object.attr[?].C ...
            // to $JUN_list_attr_new

            string $JUN_list_compund[] = `listAttr -multi ($JUN_objs_src[0]+"."+$JUN_list_attr_old[$i]+"["+(string)$indx_freeToConnect+"]")`;
            appendStringArray($JUN_list_attr_new, $JUN_list_compund, size($JUN_list_compund));
        }
    }
    JUN_cmd_upd_tsl_append_list($JUN_name_tsl_attr, $JUN_list_attr_new);
}

global proc JUN_cmd_upd_tsl_search(string $name_tsl_attr,
                                   string $name_tfg_searchInput,
                                   string $name_tsl_obj)
{
    string $attr_all[] = `textScrollList -q -allItems $name_tsl_attr`;
    string $search_input = `textField -q -tx $name_tfg_searchInput`;
    string $que[];
    for($attr in $attr_all)
        if(JUN_is_exist($attr, $search_input))
            JUN_appendString($que, $attr);

    textScrollList -e -deselectAll $name_tsl_attr;

    if(size($que)>0)
        for($item in $que)
            textScrollList -e -selectItem $item $name_tsl_attr;
    else
        JUN_cmd_upd_tsl_attr($name_tsl_obj, $name_tsl_attr, $search_input);
}


//update both obect and attribute tsl
global proc JUN_cmd_upd_tsl_obj_n_attr(string $JUN_name_tsl_obj,
                                       string $JUN_name_tsl_attr,
                                       string $JUN_name_tex_numSrc)
{
    textScrollList -e -removeAll $JUN_name_tsl_attr;
    JUN_cmd_upd_tex_numTsl($JUN_name_tsl_obj, $JUN_name_tex_numSrc);
    JUN_cmd_upd_tsl_attr($JUN_name_tsl_obj, $JUN_name_tsl_attr, "");
}


global proc JUN_cmd_makeStretch(string $name_tsl_defaultDist,
                                string $name_tsl_attr_defaultDist,
                                string $name_tsl_stretchObjs,
                                string $name_tsl_attr_stretchObjs)
{
    string $objs_defDist[] = `textScrollList -q -allItems $name_tsl_defaultDist`;
    string $attrs_defDist[] = `textScrollList -q -selectItem $name_tsl_attr_defaultDist`;
    string $objs_strcObjs[] = `textScrollList -q -allItems $name_tsl_stretchObjs`;
    string $attrs_strcObjs[] = `textScrollList -q -selectItem $name_tsl_attr_stretchObjs`;
    int $objs_siz = size($objs_defDist) > size($objs_strcObjs) ? size($objs_strcObjs) : size($objs_defDist);

    if(size($objs_defDist) == 1) // 1 -> n
    {
        for($i=0;$i<size($objs_strcObjs);$i++)
        {
            // create animCrv 
            float $dist = `getAttr ($objs_defDist[0]+"."+$attrs_defDist[0])`;
            setDrivenKeyframe -driverValue $dist -value 1 -currentDriver ($objs_defDist[0]+"."+$attrs_defDist[0] ) ($objs_strcObjs[$i]+"."+$attrs_strcObjs[0]);

            JUN_stretch_aimCrv($objs_strcObjs[$i], $attrs_strcObjs[0], $dist);
        }
    }
    else
        for($i=0;$i<$objs_siz;$i++) // n -> n
        {
            float $dist = `getAttr ($objs_defDist[$i]+"."+$attrs_defDist[0])`;
            setDrivenKeyframe -driverValue $dist -value 1 -currentDriver ($objs_defDist[$i]+"."+$attrs_defDist[0] ) ($objs_strcObjs[$i]+"."+$attrs_strcObjs[0]);

            JUN_stretch_aimCrv($objs_strcObjs[$i], $attrs_strcObjs[0], $dist);
        }

}


