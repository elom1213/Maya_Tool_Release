global proc JUN_makeUI_MEL_Stretch_Tool()
{
    string $winTitle = "Stertch Tool V01";
    string $winName = "junnyWin_Stretch_Tool_Window";
    int $win_width = 480;
    int $win_hight = 800;
    int $tsl_hight = (int)($win_hight * 0.3);
    int $tsl_hight_tab2 = (int)($win_hight * 0.27);
    if(`window -exists $winName`)
        deleteUI $winName;
    $winName = `window -title $winTitle	
                       -menuBar 1 
                       -resizeToFitChildren true`;

    menu     -label "Help"  -parent $winName;
	menuItem -label "About" -command "confirmDialog -title (\"About\") -messageAlign \"left\" -message (\"Written by Ji Hun Park \\n Update date : 28-Feb-2022\") ";

    //-------------------------------------------------
    // UI: Text Scroll List
    //-------------------------------------------------

    string $Whole_form = `columnLayout -adjustableColumn true -columnAttach "both" 10`;


        string $tabLayout_All = `tabLayout`;
        
            //-------------------------------------------------
            // tab 1 : Curve, Joint Tool
            //-------------------------------------------------
            string $tabLayout_Curve = `columnLayout -adjustableColumn true 
                                                    -columnAttach "both" 5 
                                                    -rowSpacing 5`;
                frameLayout -collapsable true
                            -bgc 0.265625 0.265625 0.265625
                            -label "Tool : Distance"; 

                    paneLayout -configuration "vertical2";

                        // Start Objects
                        columnLayout -adjustableColumn true -columnAttach "both" 5 -rowSpacing 5;
                            text -align "left" -label "Start";
                            string $name_tex_numTgt = `text -align "left" -label "Number : 0"`;
                            string $name_tsl_start = `textScrollList -h $tsl_hight -numberOfRows 5 -allowMultiSelection true`;
                            textScrollList -e -selectCommand ("JUN_cmd_tsl_select(\"" + $name_tsl_start +"\")") $name_tsl_start;

                            columnLayout -adjustableColumn true -rowSpacing 8;
                                button -label "Select" 
                                    -bgc 0 0.6 0
                                    -command ("JUN_cmd_upd_tex_numTsl(\""+$name_tsl_start+"\", \""+ $name_tex_numTgt +"\")");
                            setParent..;

                            rowLayout -nc 4;
                                button -label "Add" 
                                        -width ($win_width/8 - 12)
                                        -command ("JUN_cmd_append_selected(\""+$name_tsl_start+"\")");
                                button -label "Delete" 
                                        -width ($win_width/8 - 12)
                                        -command ("JUN_cmd_delete_selected(\""+$name_tsl_start+"\")");
                                button -label "Up" // 1
                                    -width ($win_width/8 - 8)
                                    -command ("JUN_cmd_selMov(\""+$name_tsl_start+"\"," + 1 + ")");
                                button -label "down" //0
                                    -width ($win_width/8 - 8)
                                    -command ("JUN_cmd_selMov(\""+$name_tsl_start+"\"," + 0 + ")");
                            setParent ..;

                        // columnLayout : Start Objects (close)
                        setParent ..;

                        // End Objects
                        columnLayout -adjustableColumn true -columnAttach "both" 5 -rowSpacing 5;
                            text -align "left" -label "End";
                            string $name_tex_numFlw = `text -align "left" -label "Number : 0"`;
                            string $name_tsl_end = `textScrollList -h $tsl_hight -numberOfRows 5 -allowMultiSelection true`;
                            textScrollList -e -selectCommand ("JUN_cmd_tsl_select(\"" + $name_tsl_end +"\")") $name_tsl_end;

                            columnLayout -adjustableColumn true -rowSpacing 8;
                                button -label "Select" 
                                    -bgc 0 0.6 0
                                    -command ("JUN_cmd_upd_tex_numTsl(\""+$name_tsl_end+"\", \""+ $name_tex_numFlw +"\")");
                            setParent..;
                            
                            rowLayout -nc 4;
                                button -label "Add" 
                                        -width ($win_width/8 - 12)
                                        -command ("JUN_cmd_append_selected(\""+$name_tsl_end+"\")");
                                button -label "Delete" 
                                        -width ($win_width/8 - 12)
                                        -command ("JUN_cmd_delete_selected(\""+$name_tsl_end+"\")");
                                button -label "Up" // 1
                                    -width ($win_width/8 - 8)
                                    -command ("JUN_cmd_selMov(\""+$name_tsl_end+"\"," + 1 + ")");
                                button -label "down" //0
                                    -width ($win_width/8 - 8)
                                    -command ("JUN_cmd_selMov(\""+$name_tsl_end+"\"," + 0 + ")");
                            setParent ..;

                        // columLayout : End Objects (close)
                        setParent ..;

                    // paneLayout vertical2 (close)
                    setParent ..;

                    // columnLayout : Add Objects to both textScrollList (open)
                    columnLayout -adjustableColumn true -columnAttach "both" 5 -rowSpacing 5;
                        rowLayout -nc 3;
                            button -label "Select Start End" 
                                -width ($win_width/4 - 25)
